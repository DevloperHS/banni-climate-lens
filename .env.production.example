# Production template. Copy to .env.production (git-ignored). Placeholders only - never commit real values.
GCL_DATA_DIR=/data
GCL_STATIC_DIR=/app/static
GCL_LOG_JSON=true
# Exact origin(s) of the site that calls the API (not needed when the UI is served by this container)
GCL_CORS_ORIGINS=https://climate.example.org
# REQUIRED when the API is reachable by anyone but you: protects job creation, uploads and deletes.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GCL_API_TOKEN=change-me-to-a-long-random-string
GCL_MAX_UPLOAD_MB=5
GCL_RATE_LIMIT_PER_MIN=600
GCL_MIN_COMPLETENESS=0.5
# Google Earth Engine (non-commercial project; do not enable billing)
GCL_EE_PROJECT=your-gcp-project-id
GCL_EE_SERVICE_ACCOUNT=sa-name@your-project.iam.gserviceaccount.com
GCL_EE_PRIVATE_KEY_FILE=/run/secrets/ee-key.json
