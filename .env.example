# Copy to .env (never commit .env). Placeholders only.
GCL_DATA_DIR=./data
GCL_CORS_ORIGINS=http://localhost:5173
# Google Earth Engine -- choose ONE auth mode
GCL_EE_PROJECT=your-gcp-project-id
# Mode A: service account (recommended for servers)
GCL_EE_SERVICE_ACCOUNT=your-sa@your-project.iam.gserviceaccount.com
GCL_EE_PRIVATE_KEY_FILE=./secrets/ee-key.json
# Mode B: leave service-account vars empty and run `earthengine authenticate` once (local dev)
